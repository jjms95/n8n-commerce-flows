      "id": "node-f2-lm-openrouter",
      "name": "LM - OpenRouter (CRUD)",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1,
      "position": [
        -560,
        560
      ],
