    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst norm = $('Code - Normalizar Entrada Orquestador CRUD').item.json;\nconst parseData = $('Code - Parsear Respuesta CRUD').item.json;\nconst action = parseData.action;\n\nlet msg = '';\nlet buttons = [];\nconst sep = '━'.repeat(28);\n\nif (action === 'LIST') {\n  const validProducts = items.map(i => i.json).filter(p => p && p.id && p.name && p.is_active !== false);\n\n  if (validProducts.length === 0) {\n    msg = `📦 *INVENTARIO DE PRODUCTOS*\\n${sep}\\nActualmente no tienes productos registrados o activos en tu catálogo.\\n\\n💡 *Para agregar uno escribe:* \"crear producto Camisa Azul precio 350 stock 20\"`;\n    buttons = [\n      { id: \"tareas\", title: \"📋 Ver Tareas\" },\n      { id: \"menu\", title: \"🏠 Menú Principal\" }\n    ];\n  } else {\n    let listTxt = validProducts.map((p, idx) => `${idx + 1}️⃣ *${p.name}*: $${parseFloat(p.price || 0).toFixed(2)} | Stock: ${p.stock || 0} u.`).join('\\n');\n    msg = `📦 *INVENTARIO DE PRODUCTOS*\\n${sep}\\n${listTxt}\\n${sep}\\nTotal: ${validProducts.length} productos activos.`;\n    buttons = [\n      { id: \"tareas\", title: \"📋 Ver Tareas\" },\n      { id: \"generar reporte\", title: \"📊 Reporte Hoy\" },\n      { id: \"menu\", title: \"🏠 Menú Principal\" }\n    ];\n  }\n} else if (action === 'CREATE') {\n  const p = (items[0] && items[0].json && items[0].json.name) ? items[0].json : parseData;\n  const priceVal = parseFloat(p.price || parseData.price || 0).toFixed(2);\n  const stockVal = p.stock ?? parseData.stock ?? 0;\n  msg = `✅ *PRODUCTO CREADO*\\n${sep}\\n📌 *${p.name || parseData.product_name}*\\n💰 Precio: $${priceVal}\\n📦 Stock inicial: ${stockVal} unidades`;\n  buttons = [\n    { id: \"ver inventario\", title: \"📦 Ver Inventario\" },\n    { id: \"tareas\", title: \"📋 Ver Tareas\" }\n  ];\n} else if (action === 'UPDATE_PRICE') {\n  const priceVal = parseFloat(parseData.price || 0).toFixed(2);\n  msg = `✅ *PRECIO ACTUALIZADO*\\n${sep}\\n📌 *${parseData.product_name}*\\n💰 Nuevo precio: $${priceVal}`;\n  buttons = [\n    { id: \"ver inventario\", title: \"📦 Ver Inventario\" },\n    { id: \"tareas\", title: \"📋 Ver Tareas\" }\n  ];\n} else if (action === 'DELETE') {\n  msg = `🗑️ *PRODUCTO DESACTIVADO*\\n${sep}\\n📌 *${parseData.product_name}* ha sido desactivado del catálogo.`;\n  buttons = [\n    { id: \"ver inventario\", title: \"📦 Ver Inventario\" },\n    { id: \"menu\", title: \"🏠 Menú Principal\" }\n  ];\n} else if (action === 'ADJUST_STOCK') {\n  const delta = parseData.quantity_change;\n  const sign = delta > 0 ? `+${delta}` : `${delta}`;\n  msg = `📦 *STOCK ACTUALIZADO*\\n${sep}\\n📌 *${parseData.product_name}*\\n🔄 Ajuste: ${sign} unidades.`;\n  buttons = [\n    { id: \"ver inventario\", title: \"📦 Ver Inventario\" },\n    { id: \"generar reporte\", title: \"📊 Reporte Hoy\" }\n  ];\n}\n\nreturn {\n  wa_number: norm.wa_number,\n  wa_message: msg,\n  buttons: buttons,\n  phone_number_id: norm.whatsapp_phone_number_id,\n  access_token: norm.whatsapp_access_token\n};"
      },
      "id": "node-f2-format-response",
      "name": "Code - Formatear Respuesta CRUD",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        420,
        390
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v20.0/{{ $json.phone_number_id }}/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $json.access_token }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.buttons && $json.buttons.length > 0 ? JSON.stringify({ \"messaging_product\": \"whatsapp\", \"recipient_type\": \"individual\", \"to\": $json.wa_number, \"type\": \"interactive\", \"interactive\": { \"type\": \"button\", \"body\": { \"text\": $json.wa_message }, \"action\": { \"buttons\": $json.buttons.slice(0, 3).map(b => ({ \"type\": \"reply\", \"reply\": { \"id\": b.id, \"title\": b.title.slice(0, 20) } })) } } }) : JSON.stringify({ \"messaging_product\": \"whatsapp\", \"to\": $json.wa_number, \"type\": \"text\", \"text\": { \"body\": $json.wa_message } }) }}",
        "options": {}
      },
      "id": "node-f2-http-send",
      "name": "HTTP - Enviar Respuesta WhatsApp Admin",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        390
      ]
    }
