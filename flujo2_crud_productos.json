    {
      "parameters": {
        "agent": "conversationalAgent",
        "promptType": "define",
        "text": "=Analiza la intención de gestión de catálogo de productos del negocio a partir del mensaje:\n\nMensaje: \"{{ $json.original_message }}\"\n\nDetermina la acción:\n- LIST: ver inventario, ver productos, catálogo, listar\n- CREATE: crear producto, agregar producto nuevo\n- UPDATE_PRICE: cambiar precio, actualizar precio\n- DELETE: eliminar producto, desactivar producto, borrar\n- ADJUST_STOCK: agregar stock, restar stock, sumar stock, reducir stock, modificar stock\n\nResponde ÚNICAMENTE en JSON plano:\n{\n  \"action\": \"LIST\" | \"CREATE\" | \"UPDATE_PRICE\" | \"DELETE\" | \"ADJUST_STOCK\",\n  \"product_name\": \"nombre del producto o término\",\n  \"price\": 100,\n  \"stock\": 10,\n  \"quantity_change\": 5\n}",
        "options": {
          "systemMessage": "Eres un asistente de catálogo para WhatsApp. Extraes acciones e intenciones del negocio en JSON estricto."
        }
      },
      "id": "node-f2-ai-agent",
      "name": "AI Agent - Catálogo CRUD",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        -560,
        390
      ]
    },
    {
      "parameters": {
        "jsCode": "const rawOutput = $input.item.json.output || $input.item.json.text || '{}';\nconst norm = $('Code - Normalizar Entrada Orquestador CRUD').item.json;\nlet parsed = { action: 'LIST', product_name: '', price: null, stock: null, quantity_change: 0 };\n\ntry {\n  const jsonMatch = rawOutput.match(/\\{[\\s\\S]*\\}/);\n  if (jsonMatch) parsed = JSON.parse(jsonMatch[0]);\n} catch(e) {}\n\nconst action = parsed.action || 'LIST';\nconst txtLower = (norm.original_message || '').toLowerCase();\n\nlet delta = parsed.quantity_change || 0;\nif (txtLower.includes('restar') || txtLower.includes('quitar') || txtLower.includes('reducir')) {\n  if (delta > 0) delta = -delta;\n}\n\nreturn {\n  ...norm,\n  action: action,\n  product_name: parsed.product_name || '',\n  price: parsed.price || null,\n  stock: parsed.stock || null,\n  quantity_change: delta\n};"
      },
      "id": "node-f2-parse-crud",
      "name": "Code - Parsear Respuesta CRUD",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -340,
        390
      ]
    },
