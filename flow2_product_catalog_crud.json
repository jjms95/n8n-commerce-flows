      "parameters": {
        "jsCode": "const item = $input.item.json;\nconst tenant = item.tenant || {};\nconst sender = item.sender || {};\nconst msg = item.message || {};\n\nconst text = msg.text || item.original_message || item.message || item.text || '';\nconst number = sender.number || tenant.number || item.number || '521234567890';\nconst tenantId = tenant.id || item.tenant_id || '';\nconst tenantName = tenant.name || item.tenant_name || 'Negocio';\nconst phoneId = tenant.whatsapp_phone_number_id || item.whatsapp_phone_number_id || '10023456789';\nconst token = tenant.whatsapp_access_token || item.whatsapp_access_token || 'EAAG_DEMO_TOKEN';\n\nreturn {\n  original_message: text,\n  wa_number: number,\n  tenant_id: tenantId,\n  tenant_name: tenantName,\n  whatsapp_phone_number_id: phoneId,\n  whatsapp_access_token: token,\n  tenant: tenant,\n  sender: sender\n};"
      },
