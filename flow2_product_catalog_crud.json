    {
      "parameters": {
        "jsCode": "const ctx = $('Code - Parse CRUD Intent').item.json;\nconst dbOut = $input.all().map(i => i.json);\nlet message = '';\n\nswitch (ctx.action) {\n  case 'LIST': {\n    if (!dbOut || dbOut.length === 0) {\n      message = `📦 *INVENTARIO DE PRODUCTOS*\\n🏢 *${ctx.tenant_name}*\\n\\n_No tienes productos activos registrados en tu catálogo._`;\n    } else {\n      const items = dbOut.map((p, idx) => `${idx + 1}. *${p.name}*\\n   💰 Precio: $${parseFloat(p.price || 0).toFixed(2)}\\n   📊 Stock: ${p.stock} unidades${p.stock < 5 ? ' ⚠️ *Stock Bajo*' : ''}`).join('\\n\\n');\n      message = `📦 *INVENTARIO DE PRODUCTOS*\\n🏢 *${ctx.tenant_name}*\\n\\n${items}`;\n    }\n    break;\n  }\n  case 'CREATE': {\n    message = `✅ *PRODUCTO CREADO CON ÉXITO*\\n\\n📦 *${ctx.product_name}*\\n💰 Precio: $${ctx.price.toFixed(2)}\\n📊 Stock inicial: ${ctx.stock} unidades`;\n    break;\n  }\n  case 'UPDATE_PRICE': {\n    message = `✅ *PRECIO ACTUALIZADO*\\n\\n📦 Producto: *${ctx.product_name}*\\n💰 Nuevo precio: $${ctx.price.toFixed(2)}`;\n    break;\n  }\n  case 'DELETE': {\n    message = `🗑️ *PRODUCTO DESACTIVADO*\\n\\nEl producto *${ctx.product_name}* ha sido retirado del catálogo activo.`;\n    break;\n  }\n  case 'ADJUST_STOCK': {\n    const rpcRes = dbOut[0] || {};\n    if (rpcRes.success) {\n      const diff = ctx.quantity_change > 0 ? `+${ctx.quantity_change}` : `${ctx.quantity_change}`;\n      message = `📊 *STOCK ACTUALIZADO*\\n\\n📦 Producto: *${rpcRes.product_name || ctx.product_name}*\\n🔄 Ajuste: ${diff} unidades\\n📈 Nuevo stock total: *${rpcRes.new_stock} unidades*`;\n    } else {\n      message = `❌ *Error al ajustar stock:* ${rpcRes.error || 'No se encontró el producto o el stock resultante sería negativo.'}`;\n    }\n    break;\n  }\n  default:\n    message = `ℹ️ Acción de catálogo completada.`;\n}\n\nreturn {\n  wa_number: ctx.wa_number,\n  wa_message: message,\n  phone_number_id: ctx.whatsapp_phone_number_id,\n  access_token: ctx.whatsapp_access_token\n};"
      },
