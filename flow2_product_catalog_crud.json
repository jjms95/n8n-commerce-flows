    {
      "parameters": {
        "sessionIdType": "customKey"
      },
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.4,
      "position": [
        -420,
        560
      ],
      "id": "node-f2-memory",
      "name": "Simple Memory"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Analiza la intención de gestión de catálogo de productos del negocio a partir del mensaje:\n\nMensaje: \"{{ $json.original_message }}\"\n\nDetermina la acción:\n- LIST: ver inventario, ver productos, catálogo, listar\n- CREATE: crear producto, agregar producto nuevo\n- UPDATE_PRICE: cambiar precio, actualizar precio\n- DELETE: eliminar producto, desactivar producto, borrar\n- ADJUST_STOCK: agregar stock, restar stock, sumar stock, reducir stock, modificar stock\n\nResponde ÚNICAMENTE en JSON plano:\n{\n  \"action\": \"LIST\" | \"CREATE\" | \"UPDATE_PRICE\" | \"DELETE\" | \"ADJUST_STOCK\",\n  \"product_name\": \"nombre del producto o término\",\n  \"price\": 100,\n  \"stock\": 10,\n  \"quantity_change\": 5\n}",
        "options": {
          "systemMessage": "Eres un asistente de catálogo para WhatsApp. Extraes acciones e intenciones del negocio en JSON estricto."
        }
      },
      "id": "node-f2-ai-agent",
      "name": "AI Agent - Catalog CRUD",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        -560,
        390
      ]
    },
    {
      "parameters": {
        "jsCode": "const rawOutput = $input.item.json.output || $input.item.json.text || '{}';\nconst norm = $('Code - Normalize Inbound CRUD Request').item.json;\nlet parsed = { action: 'LIST' };\n\ntry {\n  const jsonMatch = rawOutput.match(/\\{[\\s\\S]*\\}/);\n  if (jsonMatch) parsed = JSON.parse(jsonMatch[0]);\n} catch(e) {}\n\n// Handle +/- stock\nlet qty = parsed.quantity_change || 0;\nif (parsed.action === 'ADJUST_STOCK' && !qty) {\n  const msg = norm.original_message.toLowerCase();\n  const numMatch = msg.match(/(\\d+)/);\n  if (numMatch) {\n    qty = parseInt(numMatch[1], 10);\n    if (msg.includes('restar') || msg.includes('quitar') || msg.includes('reducir') || msg.includes('-')) {\n      qty = -Math.abs(qty);\n    }\n  }\n}\n\nreturn {\n  action: parsed.action || 'LIST',\n  product_name: (parsed.product_name || '').trim(),\n  price: parseFloat(parsed.price || 0),\n  stock: parseInt(parsed.stock || 0, 10),\n  quantity_change: qty,\n  wa_number: norm.wa_number,\n  tenant_id: norm.tenant_id,\n  tenant_name: norm.tenant_name,\n  whatsapp_phone_number_id: norm.whatsapp_phone_number_id,\n  whatsapp_access_token: norm.whatsapp_access_token\n};"
      },
      "id": "node-f2-parse-intent",
      "name": "Code - Parse CRUD Intent",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -340,
        390
      ]
    },
    {
